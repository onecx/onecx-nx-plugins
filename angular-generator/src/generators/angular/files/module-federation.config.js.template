const { getOneCXSharedRecommendations, getOneCXSharedLibraryConfig } = require('@onecx/build-utils');
const pkg = require('./package.json')
const { dependencies } = pkg

const sharedEntries = getOneCXSharedLibraryConfig(dependencies, true, {
  configCallback: (packageName, currentConfig) => {
    if (packageName.startsWith('@angular/')) {
      currentConfig.singleton = true;
    }
    return currentConfig;
  },
});

module.exports = {
  name: '<%= remoteName %>',
  filename: 'remoteEntry.js',
  library: { type: 'module' },
  exposes: {
    './<%= remoteModuleName %>': './src/main.ts'
  },
  shared: sharedEntries,
  shareScope: 'angular_22',
};