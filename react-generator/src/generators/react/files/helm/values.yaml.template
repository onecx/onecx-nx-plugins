productName: &product_name onecx-<%= fileName %>
product:
  info:
    data:
      name: *product_name
      description: "OneCX <%= fileName %> UI"
      displayName: "OneCX <%= fileName %>"
      basePath: "/onecx-<%= fileName %>"
app:
  name: <%= applicationName %>
  image:
    repository: 'onecx-apps/<%= applicationName %>'
  routing:
    enabled: true
    path: /mfe/onecx-<%= fileName %>/
  operator:
    # Microfrontend
    microfrontend:
      enabled: true
      specs:
        main:
          productName: *product_name
          exposedModule: './<%= remoteModuleName %>'
          shareScope: 'react_19'
          description: 'OneCX <%= fileName %> UI'
          note: 'OneCX <%= fileName %> UI auto import via MF operator'
          type: MODULE
          technology: WEBCOMPONENTMODULE
          remoteName: <%= remoteName %>
          tagName: <%= tagName %>
    # Microservice
    microservice:
      spec:
        productName: *product_name
        name: <%= applicationName %>
        description: OneCX <%= className %> Frontend
        type: ui
    # Permission
    permission:
      enabled: true
      spec:
        permissions:
        # ACTION P: Adjust permissions for the entity
