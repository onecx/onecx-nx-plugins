{
  "$schema": "http://json-schema.org/schema",
  "$id": "Preset",
  "title": "",
  "type": "object",
  "properties": {
    "appPrefix": {
      "type": "string",
      "description": "Application prefix without a trailing separator; use onecx for legacy naming.",
      "default": "",
      "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
    },
    "flavor": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What flavor would you like to use?"
    },
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What name would you like to use?"
    }
  },
  "required": ["name"]
}
